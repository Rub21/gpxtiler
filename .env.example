# Copy to .env and change the values.

# Database password.
POSTGRES_PASSWORD=change-me

# Website for update -rss and for downloading traces: the openstreetmap
# website (with /traces/rss), not the planet server with the dumps.
GPXTILER_SITE=https://gpx-tracks.rub21.com

# GPX dump for the first import (a URL, or a file in ./data as /data/...).
GPXTILER_DUMP=https://planet-gpx-tracks.rub21.com/gps/gpx-latest.gpx.bz2

# Daily list of identifiable trace ids for update -ids.
GPXTILER_IDS=https://planet-gpx-tracks.rub21.com/gpx_ids/identifiable.txt

# Ports on the host: PNG tiles (gpxtiler serve) and vector tiles (Tilekiln).
GPXTILER_PORT=8080
GPXTILER_VT_PORT=8081

# Seconds between update runs.
GPXTILER_RSS_EVERY=300
GPXTILER_IDS_EVERY=86400

# Zooms written to the expire files (one z/x/y line per zoom and tile).
GPXTILER_EXPIRE_MIN_ZOOM=0
GPXTILER_EXPIRE_MAX_ZOOM=14

# Colors per PNG tile, like pngquant on the current tiles. 0 = full color.
GPXTILER_COLORS=64

# Zooms with a simplified copy of the lines, for the low zoom tiles.
# Changing it needs a new import.
GPXTILER_LOW_ZOOMS=5,8,11

# PNG tiles on disk: pre-rendered up to PRE_ZOOM (render), cached up to
# CACHE_ZOOM (serve), drawn on every request above that.
GPXTILER_PRE_ZOOM=9
GPXTILER_CACHE_ZOOM=14

# render-expire: every RENDER_EVERY seconds, redraw the expired tiles from
# RENDER_MIN_ZOOM to PRE_ZOOM and drop the expired cached tiles.
# render-low: every RENDER_LOW_EVERY seconds, redraw all tiles up to PRE_ZOOM.
GPXTILER_RENDER_EVERY=300
GPXTILER_RENDER_MIN_ZOOM=6
GPXTILER_RENDER_LOW_EVERY=86400
